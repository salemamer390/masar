<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve Authorization header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Preserve X-XSRF-TOKEN header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    # Uploaded files are served only through the app's guarded routes, never
    # directly, even if a storage symlink or leftover directory exists here.
    RewriteRule ^storage/ - [F,L]

    # "payroll" is also a public assets directory. Route the exact URL to
    # Laravel instead of letting Apache try to browse that directory.
    RewriteRule ^payroll/?$ index.php [L]

    # Send all non-file/non-directory requests to Laravel
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

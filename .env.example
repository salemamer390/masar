APP_NAME="MASAR HR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/tazamun/public

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masar
DB_USERNAME=root
DB_PASSWORD=

# Private owner dashboard: comma-separated emails allowed to open /owner.
# No default is shipped: set the owner's real email only in the server's .env.
# While unset, /owner stays closed and answers 404 to everyone.
OWNER_EMAILS=
